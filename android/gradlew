#!/usr/bin/env sh
# ------------------------------------------------------------------------------
# Gradle start up script for UN*X
# ------------------------------------------------------------------------------
set -e
unset CDPATH
DIRNAME="$(cd "$(dirname "$0")" && pwd)"
APP_BASE_NAME="gradlew"
APP_HOME="$DIRNAME"
# Use maximum available, or set MAX_FD
[ "
${MAX_FD+set}" ] || MAX_FD=4096
# Determine default JVM options
DEFAULT_JVM_OPTS=""
CLASSPATH="$APP_HOME/gradle/wrapper/gradle-wrapper.jar"
# Execute the JVM
if [ -z "$JAVA_HOME" ]; then
  java -classpath "$CLASSPATH" $DEFAULT_JVM_OPTS org.gradle.wrapper.GradleWrapperMain "$@"
else
  "$JAVA_HOME/bin/java" -classpath "$CLASSPATH" $DEFAULT_JVM_OPTS org.gradle.wrapper.GradleWrapperMain "$@"
fi
